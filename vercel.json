{
  "rewrites": [
    {
      "source": "/hostels/media/(.*)",
      "destination": "/media/$1"
    },
    {
      "source": "/hostels/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/hostels/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/hostels/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/hostels/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}