{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["super_admin", "admin", "owner", "student"] },
        "status": { "type": "string", "enum": ["Active", "Suspended", "Flagged"] },
        "isVerified": { "type": "boolean" },
        "joinedAt": { "type": "string", "format": "date-time" },
        "shortlist": { "type": "array", "items": { "type": "string" } },
        "verificationDocs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["Aadhar", "GST", "Other"] },
              "url": { "type": "string" },
              "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
              "uploadedAt": { "type": "string", "format": "date-time" },
              "reviewedAt": { "type": "string", "format": "date-time" },
              "rejectionReason": { "type": "string" }
            }
          }
        }
      },
      "required": ["id", "email", "role"]
    },
    "Property": {
      "title": "Property",
      "description": "Public hostel, PG, flat, or mess listing (no owner PII or exact street address)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ListingName": { "type": "string", "maxLength": 150 },
        "ListingType": { "type": "string", "enum": ["Hostel", "PG", "Flat", "Mess"] },
        "Gender": { "type": "string", "enum": ["Boys", "Girls", "Unisex"] },
        "Area": { "type": "string", "maxLength": 100 },
        "RentSingle": { "type": "array", "items": { "type": "number" } },
        "RentDouble": { "type": "array", "items": { "type": "number" } },
        "ApprovalStatus": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] },
        "isFeatured": { "type": "boolean" },
        "priorityScore": { "type": "number" },
        "views": { "type": "number" },
        "leadsCount": { "type": "number" }
      },
      "required": ["id", "ownerId", "ListingName", "ListingType", "Gender", "Area", "ApprovalStatus"]
    },
    "PropertyPrivate": {
      "title": "PropertyPrivate",
      "description": "Private owner contact details and exact street address isolated from public reads",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "OwnerWhatsApp": { "type": "string", "maxLength": 30 },
        "OwnerEmail": { "type": "string", "format": "email", "maxLength": 200 },
        "EmergencyContact": { "type": "string", "maxLength": 30 },
        "FullAddress": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Student inquiry for a property",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "propertyId": { "type": "string", "maxLength": 128 },
        "propertyName": { "type": "string", "maxLength": 150 },
        "studentId": { "type": "string", "maxLength": 128 },
        "studentName": { "type": "string", "maxLength": 120 },
        "studentPhone": { "type": "string", "maxLength": 30 },
        "type": { "type": "string", "enum": ["WhatsApp", "Call", "VisitRequest"] },
        "status": { "type": "string", "enum": ["New", "Contacted", "Closed"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "propertyId", "studentId", "type", "status", "timestamp"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "tagline": { "type": "string" },
        "heroDescription": { "type": "string" },
        "heroImages": { "type": "array", "items": { "type": "string" } },
        "announcements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "link": { "type": "string" },
              "active": { "type": "boolean" }
            }
          }
        },
        "footerText": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "allowNewRegistrations": { "type": "boolean" },
        "supportWhatsApp": { "type": "string" },
        "supportPhone": { "type": "string" },
        "supportEmail": { "type": "string" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Audit log entries for administrative actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 200 },
        "importance": { "type": "string", "enum": ["low", "medium", "high"] },
        "target": { "type": "string", "maxLength": 200 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "action", "importance", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User documents"
    },
    "/properties/{propertyId}": {
      "schema": "Property",
      "description": "Public property listings without PII"
    },
    "/property_private/{propertyId}": {
      "schema": "PropertyPrivate",
      "description": "Private owner contact details and exact address isolated per property"
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Lead inquiries"
    },
    "/config/global": {
      "schema": "AppConfig",
      "description": "Global settings"
    },
    "/activity_logs/{logId}": {
      "schema": "ActivityLog",
      "description": "Platform audit logs"
    }
  }
}
